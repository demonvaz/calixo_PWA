# ---- Supabase (MISMO proyecto que usa la PWA calixo_PWA) ----
# Cópialos desde Supabase Dashboard > Project Settings > API,
# o directamente desde el .env.local del proyecto Next.js.
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- App ----
# PRE = activa premium sin pasar por Stripe (útil para desarrollo/testing en Android)
# PRO = flujo real de Stripe
APP_ENV=PRE
APP_URL=http://localhost:3000
PORT=3001
NODE_ENV=development
